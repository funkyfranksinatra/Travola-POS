// ═══════════════════════════════════════════════════════════════════
// Travola POS — schema.prisma
// Standalone build (freeze window). Same design rules as Travola-OS:
// cuid ids, integer cents, snapshots-not-joins for anything printed,
// restaurantId on every table (future multi-tenant + integration seam).
// The client generates into lib/generated/prisma so the SHARED
// node_modules (symlinked from the floor-app clone) is never touched.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalog ─────────────────────────────────────────────────────────

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id             String          @id @default(cuid())
  restaurantId   String
  categoryId     String
  category       MenuCategory    @relation(fields: [categoryId], references: [id])
  name           String
  priceCents     Int // integer cents everywhere; never floats
  station        String // "kitchen" | "bar" | custom Station.key
  active         Boolean         @default(true) // false = 86'd
  sortOrder      Int             @default(0)
  // Custom-tab items (chef/bartender specials or not-yet-entered dishes):
  // created by any staff mid-shift, replicated to every terminal, and
  // DECAYED at shift end. Permanent menu entry stays a manager act.
  ephemeral      Boolean         @default(false)
  expiresAt      DateTime?
  description    String          @default("")
  createdBy      String          @default("")
  modifierGroups ModifierGroup[]

  @@index([restaurantId, categoryId])
}

model ModifierGroup {
  id           String     @id @default(cuid())
  restaurantId String
  name         String // "Temperature", "Add-ons"
  minSelect    Int        @default(0)
  maxSelect    Int        @default(1)
  modifiers    Modifier[]
  items        MenuItem[]

  @@index([restaurantId])
}

model Modifier {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id])
  name       String // "Medium rare", "Add bacon"
  priceCents Int           @default(0)
  sortOrder  Int           @default(0)
}

// ─── Orders ──────────────────────────────────────────────────────────

model Check {
  id           String    @id @default(cuid())
  restaurantId String
  // Integration seam with the floor app (post-freeze): the party id.
  // Standalone: null. tableLabel carries the human name ("12", "Bar 3").
  partyKey     String?
  tableLabel   String
  tableId      String?   // FloorTable.id when opened from the floor view
  serverId     String?   // ServerUser.id (PIN login)
  serverName   String    @default("") // display snapshot
  status       String    @default("open") // open | closed | voided
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  subtotalCents Int      @default(0)
  taxCents      Int      @default(0)
  tipCents      Int      @default(0)
  totalCents    Int      @default(0)
  guestCount    Int      @default(1)
  currentCourse Int      @default(1)
  items        CheckItem[]
  payments     Payment[]

  @@index([restaurantId, status])
  @@index([restaurantId, openedAt])
}

model CheckItem {
  id           String    @id @default(cuid())
  checkId      String
  check        Check     @relation(fields: [checkId], references: [id])
  menuItemId   String
  nameSnapshot String // name+price frozen at order time
  priceCents   Int
  quantity     Int       @default(1)
  seat         Int?
  course       Int       @default(1)
  modifiers    Json // [{name, priceCents}] snapshot
  station      String // resolved at send time from MenuItem.station
  state        String    @default("held") // held | fired | bumped | voided
  note         String    @default("") // free-text to the kitchen/bar
  firedAt      DateTime?
  bumpedAt     DateTime?
  voidReason   String?

  @@index([checkId])
  @@index([station, state])
}

model Payment {
  id                    String   @id @default(cuid())
  restaurantId          String
  checkId               String
  check                 Check    @relation(fields: [checkId], references: [id])
  method                String // cash | card | comp
  amountCents           Int
  tipCents              Int      @default(0)
  // Phase 2 (Stripe) — populated later:
  stripePaymentIntentId String?
  status                String   @default("captured") // pending|captured|failed|refunded
  createdAt             DateTime @default(now())

  @@index([restaurantId, createdAt])
}

// ─── Staff & floor (standalone placeholders for the Travola seam) ────

model ServerUser {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  pin          String // 4-digit login PIN (pilot: plaintext; hash at multi-tenant)
  color        String // hex — mirrors the server's assigned color in Travola
  role         String @default("server") // server | manager
  sortOrder    Int    @default(0)
  tables       FloorTable[]

  @@unique([restaurantId, pin])
}

// Add-on tags: upsell chips attachable to a line at order time.
// Permanent ones are manager-created (expiresAt null). Server-created
// ones DECAY at shift end (default shift 7:00–14:00 until Travola
// integration provides real shift state) so a kitchen-rejected add-on
// never haunts tomorrow's service. Selected add-ons are snapshotted
// into CheckItem.modifiers — same money path as modifiers.
model AddOn {
  id           String    @id @default(cuid())
  restaurantId String
  menuItemId   String?   // null = global (offered on every dish)
  name         String
  priceCents   Int       @default(0)
  ephemeral    Boolean   @default(false) // true = server-created, decays
  expiresAt    DateTime? // set for ephemeral; filtered out after
  createdBy    String    @default("") // ServerUser.name snapshot
  createdAt    DateTime  @default(now())

  @@index([restaurantId, menuItemId])
}

// Static default floorplan until Travola integration ("give the word").
// Post-freeze this table is replaced by the live Travola floor state.
model FloorTable {
  id           String  @id @default(cuid())
  restaurantId String
  label        String  // "14", "Bar 1–4"
  x            Int     // percent-based geometry, 0-100
  y            Int
  w            Int     // percent width
  h            Int     // percent height
  shape        String  @default("rect") // rect | round
  serverId     String? // assigned server (section)
  server       ServerUser? @relation(fields: [serverId], references: [id])
  state        String  @default("open") // open | sat | done

  @@unique([restaurantId, label])
}

// ─── Stations & settings ─────────────────────────────────────────────

model Station {
  id           String  @id @default(cuid())
  restaurantId String
  key          String // "kitchen" | "bar" | custom
  name         String
  kind         String  @default("kds") // kds | printer (Phase 3)
  printerToken String? @unique

  @@unique([restaurantId, key])
}

model PosSettings {
  id           String @id @default(cuid())
  restaurantId String @unique
  taxRateBps   Int    @default(840) // basis points: 840 = 8.40% (Winter Park, CO combined)
  tipPresets   Json   @default("[18, 20, 25]")
  receiptFooter String @default("")
}
