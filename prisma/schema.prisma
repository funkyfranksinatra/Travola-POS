// ═══════════════════════════════════════════════════════════════════
// Travola POS — schema.prisma  (SHARED-DB build)
//
// The POS and Travola-OS point at the SAME Postgres database (Neon).
// This schema mirrors exactly the tables the POS touches:
//   · POS-owned:  Menu*, Check*, Payment, Station, AddOn, PosSettings
//   · Shared:     Server, Table, Floor, RestaurantSettings (floor app
//                 is the source of truth; POS reads + updates live
//                 state only), ServiceEvent, TableSession (the OS↔POS
//                 communication + analytics layer)
//
// ⚠ MIGRATION OWNERSHIP: the Travola-OS repo owns ALL migrations for
// this database. NEVER run `prisma migrate` or `prisma db push` from
// this repo — db push would try to reconcile the whole database to
// this partial mirror and DROP the floor app's tables. This repo runs
// `prisma generate` only.
//
// Same design rules as ever: cuid ids, integer cents, snapshots-not-
// joins for anything printed, restaurantId scoping on every query.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Shared: staff & floor (Travola-OS is the source of truth) ───────

/// The account boundary, owned by the floor app. The POS READS it to
/// verify the restaurant's name + 4-digit passcode at sign-in — the same
/// credential a manager uses on Travola-OS. The POS never creates a
/// restaurant or changes a passcode; that stays a floor-app act.
model Restaurant {
  id            String   @id @default(cuid())
  name          String
  nameKey       String   @unique
  passcodeHash  String
  recoveryEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The floor app's staff table. POS reads it for PIN login and section
/// ownership; `pin` is the one column the shared-DB migration added
/// for the POS. POS never creates or deletes servers.
model Server {
  id         String    @id @default(cuid())
  name       String
  colorHex   String?
  roles      String[]
  onShift    Boolean   @default(false)
  aiExcluded Boolean   @default(false)
  pin        String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  restaurantId String

  @@unique([restaurantId, pin])
  @@index([restaurantId, active])
}

/// The floor app's table — layout + live per-service state. POS reads
/// geometry and state for its floor view, and updates ONLY the live
/// state (seating a walk-in from the POS), never layout.
model Table {
  id               String    @id @default(cuid())
  name             String
  capacity         Int
  shape            String    @default("square")
  area             String    @default("dining")
  floorId          String    @default("f1")
  x                Int       @default(0)
  y                Int       @default(0)
  rotation         Int       @default(0)
  manualOnly       Boolean   @default(false)
  onlineExcluded   Boolean   @default(false)
  active           Boolean   @default(true)
  status           String    @default("available")
  party            String?
  partySize        Int?
  seatedAt         DateTime?
  groupId          String?
  assignedServerId String?
  liveUpdatedAt    DateTime?
  restaurantId     String

  @@index([restaurantId, active, floorId])
}

model Floor {
  id           String  @id
  name         String
  isManualOnly Boolean @default(false)
  onlineExcluded Boolean @default(false)
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  restaurantId String

  @@index([restaurantId])
}

/// Floor app settings — POS reads service hours so shift-scoped decay
/// (ephemeral add-ons/custom items) follows the REAL service day.
model RestaurantSettings {
  id           String   @id @default("main")
  openMinutes  Int?
  closeMinutes Int?
  roles        String[] @default(["waiter", "bartender"])
  prefs        Json?
  updatedAt    DateTime @updatedAt
  restaurantId String   @unique
}

// ─── Shared: the OS ↔ POS communication layer ────────────────────────

/// Append-only event bus both apps write and tail (3–5s poll). See the
/// Travola-OS schema for the full type catalog.
model ServiceEvent {
  id           String   @id @default(cuid())
  seq          BigInt   @unique @default(autoincrement())
  restaurantId String
  source       String
  type         String
  partyKey     String?
  tableIds     String[]
  serverId     String?
  checkId      String?
  serviceDate  DateTime @db.Date
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([restaurantId, seq])
  @@index([restaurantId, serviceDate, type])
}

/// One seated party, seat → clear — the analytics row shift
/// intelligence trains on. Floor writes the seating spine; POS writes
/// the money and course pacing.
model TableSession {
  id                 String    @id @default(cuid())
  restaurantId       String
  serviceDate        DateTime  @db.Date
  partyKey           String?
  partyName          String?
  tableIds           String[]
  primaryTableId     String
  serverId           String?
  guestCount         Int?
  seatedAt           DateTime
  firstOrderAt       DateTime?
  lastFireAt         DateTime?
  lastBumpAt         DateTime?
  checkPaidAt        DateTime?
  clearedAt          DateTime?
  turnMinutes        Int?
  paidToClearMinutes Int?
  checkId            String?
  subtotalCents      Int?
  totalCents         Int?
  tipCents           Int?
  ppaCents           Int?
  courseTimings      Json?
  moves              Json?
  origin             String    @default("floor")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([restaurantId, serviceDate])
  @@index([restaurantId, primaryTableId, clearedAt])
  @@index([restaurantId, checkId])
}

/// A menu upload in review (owned by the POS, migrated by Travola-OS).
/// The manager uploads a PDF or photo, extraction produces a draft, and
/// NOTHING touches the live catalog until they press Save. The draft
/// lives in the database rather than page state so a long review
/// survives a refresh or a dead tablet battery, and so there is a record
/// of what was imported. The uploaded file itself is not stored.
model MenuImport {
  id           String    @id @default(cuid())
  restaurantId String
  status       String    @default("draft") // draft | committed | discarded
  sourceName   String    @default("")
  sourceKind   String    @default("text") // text | vision
  pageCount    Int       @default(0)
  itemCount    Int       @default(0)
  createdBy    String    @default("")
  payload      Json
  commitMode   String? // merge | replace
  committedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId, status, createdAt])
}

// ─── POS-owned: catalog ──────────────────────────────────────────────

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id             String          @id @default(cuid())
  restaurantId   String
  categoryId     String
  category       MenuCategory    @relation(fields: [categoryId], references: [id])
  name           String
  priceCents     Int // integer cents everywhere; never floats
  station        String // "kitchen" | "bar" | custom Station.key
  active         Boolean         @default(true) // false = 86'd
  sortOrder      Int             @default(0)
  // Custom-tab items (chef/bartender specials or not-yet-entered dishes):
  // created by any staff mid-shift, replicated to every terminal, and
  // DECAYED at shift end. Permanent menu entry stays a manager act.
  ephemeral      Boolean         @default(false)
  expiresAt      DateTime?
  description    String          @default("")
  createdBy      String          @default("")
  modifierGroups ModifierGroup[]

  @@index([restaurantId, categoryId])
}

model ModifierGroup {
  id           String     @id @default(cuid())
  restaurantId String
  name         String // "Temperature", "Add-ons"
  minSelect    Int        @default(0)
  maxSelect    Int        @default(1)
  modifiers    Modifier[]
  items        MenuItem[]

  @@index([restaurantId])
}

model Modifier {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id])
  name       String // "Medium rare", "Add bacon"
  priceCents Int           @default(0)
  sortOrder  Int           @default(0)
}

// ─── POS-owned: orders ───────────────────────────────────────────────

model Check {
  id           String    @id @default(cuid())
  restaurantId String
  // The party seam, now LIVE: reservation/waitlist id from the shared
  // floor state. tableLabel carries the human name ("12", "Bar 3").
  partyKey     String?
  tableLabel   String
  tableId      String?   // shared Table.id when opened from the floor view
  serverId     String?   // shared Server.id (PIN login)
  serverName   String    @default("") // display snapshot
  status       String    @default("open") // open | closed | voided
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  subtotalCents Int      @default(0)
  taxCents      Int      @default(0)
  tipCents      Int      @default(0)
  totalCents    Int      @default(0)
  guestCount    Int      @default(1)
  currentCourse Int      @default(1)
  items        CheckItem[]
  payments     Payment[]

  @@index([restaurantId, status])
  @@index([restaurantId, openedAt])
  @@index([restaurantId, tableId, status])
}

model CheckItem {
  id           String    @id @default(cuid())
  checkId      String
  check        Check     @relation(fields: [checkId], references: [id])
  menuItemId   String
  nameSnapshot String // name+price frozen at order time
  priceCents   Int
  quantity     Int       @default(1)
  seat         Int?
  course       Int       @default(1)
  modifiers    Json // [{name, priceCents}] snapshot
  station      String // resolved at send time from MenuItem.station
  state        String    @default("held") // held | fired | bumped | voided
  note         String    @default("") // free-text to the kitchen/bar
  firedAt      DateTime?
  bumpedAt     DateTime?
  voidReason   String?

  @@index([checkId])
  @@index([station, state])
}

model Payment {
  id                    String   @id @default(cuid())
  restaurantId          String
  checkId               String
  check                 Check    @relation(fields: [checkId], references: [id])
  method                String // cash | card | comp | card_external
  amountCents           Int
  tipCents              Int      @default(0)
  // Phase 2 (Stripe) — populated later:
  stripePaymentIntentId String?
  status                String   @default("captured") // pending|captured|failed|refunded
  createdAt             DateTime @default(now())

  @@index([restaurantId, createdAt])
}

// ─── POS-owned: add-ons, stations, settings ──────────────────────────

// Add-on tags: upsell chips attachable to a line at order time.
// Permanent ones are manager-created (expiresAt null). Server-created
// ones DECAY at shift end so a kitchen-rejected add-on never haunts
// tomorrow's service. Selected add-ons are snapshotted into
// CheckItem.modifiers — same money path as modifiers.
model AddOn {
  id           String    @id @default(cuid())
  restaurantId String
  menuItemId   String?   // null = global (offered on every dish)
  name         String
  priceCents   Int       @default(0)
  ephemeral    Boolean   @default(false) // true = server-created, decays
  expiresAt    DateTime? // set for ephemeral; filtered out after
  createdBy    String    @default("") // Server.name snapshot
  createdAt    DateTime  @default(now())

  @@index([restaurantId, menuItemId])
}

model Station {
  id           String  @id @default(cuid())
  restaurantId String
  key          String // "kitchen" | "bar" | custom
  name         String
  kind         String  @default("kds") // kds | printer (Phase 3)
  printerToken String? @unique

  @@unique([restaurantId, key])
}

model PosSettings {
  id           String @id @default(cuid())
  restaurantId String @unique
  taxRateBps   Int    @default(840) // basis points: 840 = 8.40%
  tipPresets   Json   @default("[18, 20, 25]")
  receiptFooter String @default("")
}
