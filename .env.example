# SHARED DATABASE: the same Neon Postgres the Travola-OS floor app uses.
# The OS repo owns all migrations — this app only ever `prisma generate`s.
# NEVER commit .env.
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# The Restaurant.id (from the shared DB) this POS deployment serves.
# Falls back to "rest_demo" for local scratch databases.
POS_RESTAURANT_ID=""
