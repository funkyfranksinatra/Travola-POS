# SHARED DATABASE: the same Neon Postgres the Travola-OS floor app uses.
# The OS repo owns all migrations — this app only ever `prisma generate`s.
# NEVER commit .env.
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# Signs the restaurant-session cookie. Use the SAME value as Travola-OS
# so the two apps' sessions stay interchangeable if they ever share a
# domain. Any long random string works; changing it signs everyone out.
SESSION_SECRET=""

# OPTIONAL, non-production only: pin local sandboxes and the seed script
# to one restaurant without signing in. Ignored when NODE_ENV=production —
# in production the tenant always comes from the signed-in session.
POS_RESTAURANT_ID=""
